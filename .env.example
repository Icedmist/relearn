# ReLearn runtime configuration.
# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
# Only the publishable (anon) key belongs here. Row Level Security enforces
# access. The secret / service_role key must never be shipped to the app.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional. Set to true to force the in-memory demo store even when the
# Supabase values above are present.
DEMO_MODE=false
