# ReLearn environment template.
# Copy to .env (never commit .env) or pass values with --dart-define.

# Supabase project URL (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key. Safe for the client because Row Level Security enforces access.
SUPABASE_ANON_KEY=your-anon-key

# Keep true until the backend is wired. The app then uses seeded demo data.
DEMO_MODE=true

# NEVER add the service-role key here. It bypasses RLS and must stay server-side.
